# ---------------------------------------------------------------------------
# commercial-inbox-worker — variables de entorno
# Copiar a .env y completar. NUNCA commitear .env
# ---------------------------------------------------------------------------

NODE_ENV=development

# ---------------------------------------------------------------------------
# SEGURIDAD — leer antes de tocar
# ---------------------------------------------------------------------------
# Dos flags independientes, ambos apagados por default. Con los dos en false el
# worker clasifica y guarda en la base, y no escribe nada afuera.
# Se habilitan por separado y en este orden.

# Labels y archivado en Gmail. Un error acá se deshace en dos clics.
# Requiere GMAIL_SCOPE con gmail.modify: si no, el config falla al bootear.
GMAIL_WRITE_ENABLED=false

# Snov y CRM. Un error acá no se deshace limpio: una dirección subida a
# do-not-email saca al prospect de todas las campañas activas.
# Requiere GMAIL_WRITE_ENABLED=true.
EXTERNAL_WRITE_ENABLED=false

# Categorías habilitadas para acción automática (CSV).
# Vacío = todo va a revisión humana. Se van sumando de a una según fase.
# Orden sugerido: UNDELIVERABLE,UNSUBSCRIBE,OOO → NO_THANKS,NOT_NOW,REFERRAL
AUTO_CATEGORIES=

# HOT nunca se automatiza. Si aparece acá, el executor debe tirar error al bootear.

# ---------------------------------------------------------------------------
# BASE DE DATOS (propia — NO apuntar nunca al SQLite del CRM)
# ---------------------------------------------------------------------------
# Ruta relativa a la raíz del repo. src/database-url.ts la pasa a absoluta antes
# de abrirla, para que el cwd de PM2 no cambie a qué archivo apunta.
DATABASE_URL="file:./data/triage.db"

# ---------------------------------------------------------------------------
# GMAIL API
# ---------------------------------------------------------------------------
# Casilla real de Ally, también durante desarrollo. Las barreras son los dos flags
# de escritura de arriba y el scope readonly de más abajo.
GMAIL_USER_EMAIL=ally.taylor@mycompany.co

GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3100/oauth/callback

# Se obtiene una vez con `npm run auth:gmail` y se pega acá.
GMAIL_REFRESH_TOKEN=

# Fase 1-3: gmail.readonly | Fase 4+: gmail.modify
GMAIL_SCOPE=https://www.googleapis.com/auth/gmail.readonly

# ---------------------------------------------------------------------------
# CLASIFICADOR
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=

# El default es Opus 5. El volumen es ~50 mails/día: con prompt caching sobre la
# taxonomía, el costo es de unos pocos dólares al mes con cualquier modelo, así
# que la elección se hace por precisión en los bordes difíciles
# (TO_MANUAL_SORT vs HOT vs NOT_NOW), no por precio.
ANTHROPIC_MODEL=claude-opus-5

# Debajo de este umbral el mail va a revisión humana en vez de acción automática.
CONFIDENCE_THRESHOLD=0.75

# ---------------------------------------------------------------------------
# SNOV.IO
# ---------------------------------------------------------------------------
# Cuenta de Loredana (Operations/Commercial), según el manual.
SNOV_CLIENT_ID=
SNOV_CLIENT_SECRET=
SNOV_API_BASE=https://api.snov.io

# IDs de listas — obtener con `GET /v1/get-user-lists` y pegar acá.
# (`/v1/lists` devuelve 403: no es la ruta.) Nunca hardcodear en el código.
SNOV_LIST_NO_THANKS=
SNOV_LIST_NOT_NOW=
SNOV_LIST_REFERRALS=

# Id de `Do-not-email (full list)`, la lista que usan las campanas de Ally.
# NO aparece en get-user-lists: se lee con `npm run snov:do-not-email`
# (GET /v2/blacklists) o desde Campaigns -> Do-not-contact lists en la UI.
#
# La cuenta tiene SIETE listas de do-not-contact, dos con decenas de miles de
# entradas. Una baja en la equivocada devuelve 200 y no protege de nada, asi
# que el id se manda siempre y no se deja que Snov elija. Vacio = usa el
# default del codigo, que es el id verificado de la full list.
SNOV_DO_NOT_EMAIL_LIST=

# ---------------------------------------------------------------------------
# CRM (crm.mycompany.co) — solo por HTTP, nunca acceso directo a su base
# ---------------------------------------------------------------------------
# Base del CRM. En el EC2 va por loopback: el worker corre en la misma máquina,
# así que se saltea nginx y el DNS. Un hop menos y no depende de que el dominio
# resuelva.
#
# NUNCA apuntarlo al dominio público por http: el CRM_SERVICE_TOKEN viaja en un
# header, y sobre http sin TLS saldría en texto plano a internet. Sobre loopback
# no hace falta TLS porque el tráfico no sale de la máquina — son dos casos
# distintos y solo el segundo es seguro sin cifrado.
#
# En la máquina de desarrollo no hay CRM levantado: esta URL no resuelve, y está
# bien que así sea. Falla cerrado en vez de mandar la credencial a algún lado.
CRM_BASE_URL=http://127.0.0.1:3000
CRM_SERVICE_TOKEN=

# ---------------------------------------------------------------------------
# WORKER
# ---------------------------------------------------------------------------
# Con ~50 mails/día, 10 minutos sobra.
# Cada cuántas horas el worker revisa Spam buscando respuestas de prospects que
# Gmail marcó mal. Dos veces por día alcanza: el volumen es bajo y cada mensaje
# cuesta una consulta a Snov y otra al CRM.
SPAM_SWEEP_HOURS=12
POLL_INTERVAL_MINUTES=10

# Tope por corrida, para que un backlog grande no dispare cientos de llamadas.
MAX_MESSAGES_PER_RUN=50

# ---------------------------------------------------------------------------
# REPROCESO POR ETIQUETA
# ---------------------------------------------------------------------------
# Cuando una persona revisa un correo, le pone la etiqueta correcta y le agrega
# REPROCESS, el worker ejecuta lo que dicen esas etiquetas — sin volver a
# clasificar: la etiqueta ES la decisión.
#
# Apagado por default como todo lo que actúa afuera. Necesita GMAIL_SCOPE con
# gmail.modify: sin poder quitar la etiqueta REPROCESS el mismo correo se
# reprocesaría en cada corrida, y el worker falla al bootear si no lo tiene.
REPROCESS_ENABLED=false

# Tope de reprocesos por corrida. Presupuesto propio y no el de
# MAX_MESSAGES_PER_RUN: son dos colas distintas y ésta es de volumen manual.
REPROCESS_MAX_PER_RUN=20

LOG_LEVEL=info

# --- Log en el Sheet del Drive de Ally -------------------------------------
# Flag propio: NO cuelga de EXTERNAL_WRITE_ENABLED, porque el log tiene que
# funcionar justamente en shadow mode. Escribe en una planilla nuestra, no en la
# casilla de Ally ni en Snov.
SHEET_LOG_ENABLED=false
# El id sale de la URL del Sheet:
#   docs.google.com/spreadsheets/d/<ESTO>/edit
SHEET_LOG_ID=
# Ruta al JSON de la service account. Relativa se resuelve contra la raíz del
# repo. El archivo va en secrets/, que está en .gitignore — la clave privada NO
# va en este .env: son 1700 caracteres con saltos escapados y se rompen en silencio.
# El Sheet tiene que estar compartido con el client_email de ese JSON, con permiso
# de edición.
GOOGLE_SERVICE_ACCOUNT_FILE=secrets/tu-proyecto-abc123.json

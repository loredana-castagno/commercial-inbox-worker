    "snov:listas": "tsx src/scripts/snov-listas.ts",
    "evals": "tsx src/scripts/evals.ts",
    "dataset:rebuild": "tsx src/scripts/dataset-rebuild.ts",
    "worker": "tsx src/worker.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.118.0",
    "@prisma/adapter-better-sqlite3": "^7.9.1",
    "@prisma/client": "^7.9.1",
    "dotenv": "^16.4.7",
    "googleapis": "^175.0.0",
    "zod": "^3.24.1"

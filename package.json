{
  "name": "commercial-inbox-worker",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "prisma generate && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "rescatar:spam": "tsx src/scripts/rescatar-spam.ts",
    "reprocesar:inbox": "tsx src/scripts/reprocesar-inbox.ts",
    "reprocesar:mensaje": "tsx src/scripts/reprocesar-mensaje.ts",
    "crm:verificar": "tsx src/scripts/verificar-crm.ts",
    "snov:verificar-escritura": "tsx src/scripts/verificar-escritura-snov.ts",
    "snov:probar-relista": "tsx src/scripts/snov-probar-relista.ts",
    "snov:verificar-email": "tsx src/scripts/snov-verificar-email.ts",
    "test": "node --import tsx --test \"src/**/*.test.ts\"",
    "config:check": "tsx src/scripts/check-config.ts",
    "auth:gmail": "tsx src/scripts/auth-gmail.ts",
    "gmail:peek": "tsx src/scripts/gmail-peek.ts",
